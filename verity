<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>التحقق من الشهادة | Quran Nation Academy</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color:#fcfaf6; font-family:'Tajawal', sans-serif; min-height:100vh; }
        .serif { font-family:'Playfair Display', 'Tajawal', serif; }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-4">
    <div class="w-full max-w-md bg-white rounded-[2rem] shadow-2xl border border-slate-100 p-8 text-center">
        <div id="loading">
            <div class="text-4xl mb-3">⏳</div>
            <p class="text-slate-500 font-medium">جاري التحقق من الشهادة...</p>
        </div>

        <div id="foundBox" class="hidden">
            <div class="text-5xl mb-3">✅</div>
            <h1 class="serif text-xl font-bold text-emerald-800 mb-4">شهادة موثّقة وصحيحة</h1>
            <div class="text-right space-y-2 bg-emerald-50 border border-emerald-200 rounded-2xl p-5 text-sm">
                <p><span class="font-bold">الاسم:</span> <span id="rName"></span></p>
                <p><span class="font-bold">الصفة:</span> <span id="rType"></span></p>
                <p><span class="font-bold">الدورة/البرنامج:</span> <span id="rCourse"></span></p>
                <p><span class="font-bold">نوع الشهادة:</span> <span id="rCert"></span></p>
                <p><span class="font-bold">تاريخ الإصدار:</span> <span id="rDate"></span></p>
            </div>
            <p class="text-xs text-slate-400 mt-4">صادرة رسمياً عن Quran Nation Academy</p>
        </div>

        <div id="notFoundBox" class="hidden">
            <div class="text-5xl mb-3">❌</div>
            <h1 class="serif text-xl font-bold text-rose-700 mb-2">لم يتم العثور على شهادة بهذا الرمز</h1>
            <p class="text-sm text-slate-500">تأكد من أن الرابط أو الباركود صحيح، أو تواصل مع الأكاديمية.</p>
        </div>

        <div id="noIdBox" class="hidden">
            <div class="text-5xl mb-3">⚠️</div>
            <h1 class="serif text-xl font-bold text-slate-700">لا يوجد رمز شهادة في الرابط</h1>
        </div>
    </div>

    <script>
        const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxTunm8TxeAGY-eJ-ql7YBBYbRm5GocY9yg4Ihxf9c4aD4XKtCWCbLYkIEXxjw_BSqbxw/exec"; // نفس رابط Apps Script المستخدم في الفورمين

        const params = new URLSearchParams(window.location.search);
        const id = params.get('id');

        const loading = document.getElementById('loading');
        const foundBox = document.getElementById('foundBox');
        const notFoundBox = document.getElementById('notFoundBox');
        const noIdBox = document.getElementById('noIdBox');

        if (!id) {
            loading.classList.add('hidden');
            noIdBox.classList.remove('hidden');
        } else {
            fetch(`${APPS_SCRIPT_URL}?id=${encodeURIComponent(id)}`)
                .then(res => res.json())
                .then(data => {
                    loading.classList.add('hidden');
                    if (data.found) {
                        document.getElementById('rName').textContent = data.fullName;
                        document.getElementById('rType').textContent = data.type === 'Teachers' ? 'معلمة' : 'طالب/ـة';
                        document.getElementById('rCourse').textContent = data.course;
                        document.getElementById('rCert').textContent = data.certType;
                        document.getElementById('rDate').textContent = data.date;
                        foundBox.classList.remove('hidden');
                    } else {
                        notFoundBox.classList.remove('hidden');
                    }
                })
                .catch(() => {
                    loading.classList.add('hidden');
                    notFoundBox.classList.remove('hidden');
                });
        }
    </script>
</body>
</html>
